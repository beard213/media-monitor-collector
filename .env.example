APP_NAME=foreign-media-collector
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/media_monitor.db
STORAGE_ROOT=./data/storage
ADMIN_API_KEY=

ACCOUNT_LEASE_TTL_SECONDS=1800
DEFAULT_COLLECTION_INTERVAL_SECONDS=3600
WORKER_ID=local-worker-1

YOUTUBE_ENABLED=true
YOUTUBE_COOKIE_FILE=
YOUTUBE_COOKIE_DIR=./data/storage/private/youtube_cookies
# Multiple *.netscape files in YOUTUBE_COOKIE_DIR are used sequentially as a
# fallback pool. A failed auth/rate-limited session is skipped for this period.
YOUTUBE_COOKIE_POOL_COOLDOWN_SECONDS=900
# Stability-first account media policy: at most this many newest videos are
# downloaded per account job; consecutive uncached YouTube downloads pause.
COLLECTOR_ACCOUNT_MEDIA_ITEMS_PER_ACCOUNT=10
YOUTUBE_DOWNLOAD_PACING_SECONDS=2
COLLECTOR_SCHEDULED_BULK_MEDIA_ITEMS_PER_ACCOUNT=3
COLLECTOR_SCHEDULED_BULK_COLLECT_COMMENTS=false
COLLECTOR_SCHEDULED_BULK_ACCOUNT_PAUSE_SECONDS=1
COLLECTOR_SCHEDULED_BULK_CHUNK_SIZE=20
COLLECTOR_SCHEDULED_BULK_CHUNK_PAUSE_SECONDS=15
PRIORITY_ACCOUNT_WATCH_ENABLED=false
PRIORITY_ACCOUNT_WATCH_INTERVAL_SECONDS=300
PRIORITY_ACCOUNT_WATCH_MAX_ACCOUNTS=150
PRIORITY_ACCOUNT_WATCH_RETRY_SECONDS=60
YOUTUBE_BROWSER=chromium
YOUTUBE_BROWSER_PROFILE=
YOUTUBE_BROWSER_CDP_URL=
YOUTUBE_PROXY=
YOUTUBE_OUTPUT_ROOT=./data/storage/youtube
YOUTUBE_DEFAULT_COMMENTS=100
YOUTUBE_JS_RUNTIME=/home/ubuntu/.deno/bin/deno
YOUTUBE_REMOTE_COMPONENTS=ejs:github
YOUTUBE_DISABLE_PLUGINS=true
YOUTUBE_LIVE_CLIP_SECONDS=60
TIKTOK_ENABLED=false
TIKTOK_BROWSER=chromium
TIKTOK_BROWSER_PROFILE=
TIKTOK_BROWSER_CDP_URL=
TIKTOK_OUTPUT_ROOT=./data/storage/tiktok
STREAMLINK_ENABLED=false
STREAMLINK_PLATFORMS=
STREAMLINK_PILOT_TARGETS=
STREAMLINK_QUALITY=best
FACEBOOK_ENABLED=false
FACEBOOK_BROWSER=chromium
FACEBOOK_BROWSER_PROFILE=
FACEBOOK_BROWSER_CDP_URL=
FACEBOOK_OUTPUT_ROOT=./data/storage/facebook
X_ENABLED=false
X_BROWSER=chromium
X_BROWSER_PROFILE=
X_BROWSER_CDP_URL=
X_OUTPUT_ROOT=./data/storage/x
INSTAGRAM_ENABLED=false
INSTAGRAM_BROWSER=chromium
INSTAGRAM_BROWSER_PROFILE=
INSTAGRAM_BROWSER_CDP_URL=
INSTAGRAM_OUTPUT_ROOT=./data/storage/instagram

COLLECTOR_SYNC_ENABLED=false
# Set true only after the business backend accepts metadata-only content
# upserts with nullable videoUrl/thumbnailUrl and mediaStatus.
COLLECTOR_METADATA_ONLY_SYNC_ENABLED=false
COLLECTOR_BACKEND_BASE_URL=http://backend.example.internal/api/v1
COLLECTOR_PUBLIC_BASE_URL=http://127.0.0.1:18083
COLLECTOR_ACCESS_KEY=change-me
COLLECTOR_ACCESS_TOKEN=change-me
COLLECTOR_BACKEND_TIMEOUT_SECONDS=300
COLLECTOR_MEDIA_TIMEOUT_SECONDS=30
COLLECTOR_HEARTBEAT_INTERVAL_SECONDS=5
COLLECTOR_HEARTBEAT_TIMEOUT_SECONDS=10
AGENT_INGEST_ENABLED=true
AGENT_BASE_URL=http://127.0.0.1:8088
AGENT_INGEST_URL=http://127.0.0.1:8088/api/agent/ingest
AGENT_INGEST_STRATEGY=rag_repair
AGENT_INGEST_TIMEOUT_SECONDS=5
AGENT_INGEST_MAX_ATTEMPTS=2
AGENT_INGEST_RETRY_INTERVAL_SECONDS=0.2
KEYWORD_DB_FALLBACK_ENABLED=false
KEYWORD_DB_HOST=
KEYWORD_DB_PORT=3306
KEYWORD_DB_NAME=
KEYWORD_DB_USER=
KEYWORD_DB_PASSWORD=
BROWSER_COMMENT_COLLECTION_ENABLED=true
BROWSER_COMMENT_LIMIT=50
BROWSER_COMMENT_TIMEOUT_SECONDS=45
COLLECTOR_CLEANUP_ENABLED=true
COLLECTOR_CLEANUP_RETENTION_HOURS=24
COLLECTOR_CLEANUP_PARTIAL_RETENTION_HOURS=1
COLLECTOR_CLEANUP_EMPTY_DIRS=true
COLLECTOR_MEMORY_GC_ENABLED=true

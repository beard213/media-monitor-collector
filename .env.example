TIKTOK_ENABLED=false
TIKTOK_BROWSER=chromium
TIKTOK_BROWSER_PROFILE=
TIKTOK_BROWSER_CDP_URL=

FACEBOOK_ENABLED=false
FACEBOOK_BROWSER=chromium
FACEBOOK_BROWSER_PROFILE=
FACEBOOK_BROWSER_CDP_URL=

X_ENABLED=false
X_BROWSER=chromium
X_BROWSER_PROFILE=
X_BROWSER_CDP_URL=

INSTAGRAM_ENABLED=false
INSTAGRAM_BROWSER=chromium
INSTAGRAM_BROWSER_PROFILE=
INSTAGRAM_BROWSER_CDP_URL=

COLLECTOR_SYNC_ENABLED=false
COLLECTOR_BACKEND_BASE_URL=
COLLECTOR_ACCESS_KEY=change-me-key
COLLECTOR_ACCESS_TOKEN=change-me-token

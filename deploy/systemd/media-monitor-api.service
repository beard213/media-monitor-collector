[Unit]
Description=Media Monitor Collector API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=media-monitor
Group=media-monitor
WorkingDirectory=/opt/media-monitor
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/media-monitor/.env
ExecStart=/opt/media-monitor/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 18083
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

[Unit]
Description=Media Monitor Collector API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/media-monitor
Environment=PYTHONUNBUFFERED=1
Environment=MEDIA_MONITOR_RECOVER_LIVE_JOBS=1
Environment=MEDIA_MONITOR_RECONCILE_JOBS_ON_STARTUP=1
EnvironmentFile=-/home/ubuntu/media-monitor/.env
ExecStart=/home/ubuntu/media-monitor/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 18083
Restart=always
RestartSec=5
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=30
# Keep a runaway browser/ffmpeg job inside the service cgroup.  The host has
# 8 GiB RAM and 2 vCPUs; crossing these limits must restart the collector,
# rather than consume the host's swap and make the whole VM unresponsive.
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=512M
CPUQuota=180%
TasksMax=512
LimitNOFILE=4096
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
